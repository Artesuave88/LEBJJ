{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/api/contact/?(?:/__data.json)?$",
			"dest": "/api/contact"
		},
		{
			"src": "^/api/health/?(?:/__data.json)?$",
			"dest": "/api/health"
		},
		{
			"src": "^/api/trial/?(?:/__data.json)?$",
			"dest": "/api/trial"
		},
		{
			"src": "^/coaches/?(?:/__data.json)?$",
			"dest": "/coaches"
		},
		{
			"src": "^/contact/?(?:/__data.json)?$",
			"dest": "/contact"
		},
		{
			"src": "^/gallery/?(?:/__data.json)?$",
			"dest": "/gallery"
		},
		{
			"src": "^/kids/?(?:/__data.json)?$",
			"dest": "/kids"
		},
		{
			"src": "^/pricing/?(?:/__data.json)?$",
			"dest": "/pricing"
		},
		{
			"src": "^/robots\\.txt/?(?:/__data.json)?$",
			"dest": "/robots.txt"
		},
		{
			"src": "^/sitemap\\.xml/?(?:/__data.json)?$",
			"dest": "/sitemap.xml"
		},
		{
			"src": "^/timetable/?(?:/__data.json)?$",
			"dest": "/timetable"
		},
		{
			"src": "^/trial/?(?:/__data.json)?$",
			"dest": "/trial"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}